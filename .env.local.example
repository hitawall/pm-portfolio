# Sanity — copy this to .env.local and fill in your values
# Get these from https://sanity.io/manage → your project → API

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: used by the /api/revalidate webhook
# Set this in Vercel too, then register the URL in Sanity webhook settings:
# https://your-site.vercel.app/api/revalidate?secret=<this_value>
SANITY_REVALIDATE_SECRET=a_random_secret_string

# Optional: live GitHub stats in the homepage hero (contributions, last commit).
# Fine-grained PAT with NO permissions (public data only) — create at
# https://github.com/settings/personal-access-tokens/new
# Without it the hero renders static fallback values. Set in Vercel too.
GITHUB_TOKEN=your_github_pat_here
